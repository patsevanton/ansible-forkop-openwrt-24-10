# /etc/config/forkop
# Сгенерировано Ansible из эталонного роутера (Forkop 1.0.5).
# Домены и IP-адреса (option domain / option ip_cidr) не переносятся —
# их настраивают вручную в LuCI -> Forkop.

config settings 'settings'
	option config_version '1.0.5'
	list applied_migrations 'interface_sections'
	list applied_migrations 'enable_component_checks'
	list applied_migrations 'http_connection_urls'
	option dns_type 'doh'
	list bootstrap_dns_server '77.88.8.8'
	option dns_check_interval '10s'
	option dns_recovery_check_interval '60s'
	option dns_check_timeout '2s'
	option dns_rewrite_ttl '3600'
	option dns_strategy 'prefer_ipv4'
	option dns_detour_enabled '0'
	list source_network_interfaces 'br-lan'
	option enable_output_network_interface '0'
	option enable_badwan_interface_monitoring '1'
	option enable_yacd '1'
	option disable_quic '1'
	option list_update_enabled '1'
	option update_interval '1d'
	option component_update_check_enabled '1'
	option component_update_check_interval '1d'
	option latency_test_url 'https://www.gstatic.com/generate_204'
	option download_lists_via_proxy '{{ forkop_download_lists_via_proxy }}'
	option download_components_via_proxy '1'
	option dont_touch_dhcp '0'
	option config_path '/etc/sing-box/config.json'
	option cache_path '/tmp/sing-box/cache.db'
	option log_level 'warn'
	option exclude_ntp '0'
	option shutdown_correctly '0'
	list dns_server '1.1.1.1'
	list badwan_monitored_interfaces 'wan'
	option badwan_reload_delay '2000'
	option download_lists_via_proxy_section 'main'
	option download_components_via_proxy_section 'main'
	option enable_yacd_wan_access '0'

config section 'main'
	option enabled '1'
	option action 'connection'
	option outbound_detour_enabled '0'
	option sort_by_latency '1'
	option mixed_proxy_enabled '0'
	option resolve_real_ip_for_routing '0'
	option dashboard_filter_mode 'exclude'
	option dashboard_detect_server_country 'flag_emoji'
	option dashboard_exclude_proxy_parameters '0'
{% for name in forkop_community_lists %}
	list community_lists '{{ name }}'
{% endfor %}
	list dashboard_exclude_countries 'GB'
	list dashboard_exclude_countries 'RU'
	list dashboard_exclude_outbounds '🚀 Авто выбор'

config section 'russian'
	option enabled '1'
	option action 'connection'
	option outbound_detour_enabled '0'
	option sort_by_latency '0'
	option mixed_proxy_enabled '0'
	option resolve_real_ip_for_routing '0'
	option dashboard_filter_mode 'include'
	option dashboard_detect_server_country 'flag_emoji'
	list dashboard_include_countries 'RU'
	option dashboard_include_proxy_parameters '0'
{% for section in ['main', 'russian'] %}
{% for url in forkop_subscriptions if url | length > 0 %}

config subscription_url
	option section '{{ section }}'
	option url '{{ url }}'
	option subscription_update_enabled '1'
	option subscription_update_interval '1h'
	option download_via_proxy_enabled '0'
	option auto_user_agent '1'
	option auto_hwid '1'
	option show_dashboard_metadata '1'
	option prefix_nodes '0'
	option include_urltest_groups '1'
	option hide_urltest_group_outbounds '1'
	option hide_detour_outbounds '1'
{% endfor %}
{% endfor %}

config priority_group 'pg_77450153'
	option section 'main'
	option health_url 'https://www.gstatic.com/generate_204'
	option active_check_interval '5s'
	option check_timeout '2s'
	option recovery_check_interval '15s'
	option pick_fastest '0'
	option switch_to_faster_same_priority '0'
	option fastest_check_interval '3m'
	option interrupt_exist_connections '1'
	option pin_dashboard '1'
	option name 'main-priority'

config priority_level 'pl_primary'
	option group 'pg_77450153'
	option name 'Основные (hy2)'
	option order '0'
	option direct '0'
	# Только hysteria2. Демон проверяет активный узел каждые 5 с и при отказе
	# берёт первый живой, тратя до 2 с на каждую мёртвую пробу, поэтому уровень
	# должен быть коротким: hy2-узлов в подписке единицы и они стабильны.
	option filter_mode 'mixed'
	option include_proxy_parameters '1'
	list include_protocols 'hysteria2'
	# Страна по флагу в имени: country_is резолвит домены узлов, а они за CDN
	# и почти все определяются как AE.
	option detect_server_country 'flag_emoji'
	list exclude_countries 'RU'
	list exclude_countries 'GB'
{% for code in forkop_priority_exclude_countries %}
	list exclude_countries '{{ code }}'
{% endfor %}

config priority_level 'pl_near'
	option group 'pg_77450153'
	option name 'Ближние'
	option order '1'
	option direct '0'
	# Если все hy2 легли (например, провайдер режет UDP) — ближние страны,
	# где есть стабильно живые узлы.
	option filter_mode 'include'
	option detect_server_country 'flag_emoji'
{% for code in forkop_priority_near_countries %}
	list include_countries '{{ code }}'
{% endfor %}

config priority_level 'pl_reserve'
	option group 'pg_77450153'
	option name 'Резерв'
	option order '2'
	option direct '0'
	option filter_mode 'disabled'

config priority_level 'pl_direct'
	option group 'pg_77450153'
	option name 'Напрямую'
	option order '3'
	option direct '1'
